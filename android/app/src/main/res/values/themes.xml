<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The web layer paints the whole screen. The only job this theme has is to make the
      window match the wallet's page background (#f8f8f8) so there is no white or black
      flash before the WebView draws, which is the same reason WebHostView sets
      isOpaque = false and a matching backgroundColor on iOS.
    -->
    <style name="Theme.Nimmesh" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:statusBarColor">@color/page_background</item>
        <item name="android:navigationBarColor">@color/page_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- The scanner is a full-bleed camera view, so it gets a black ground rather than the
         wallet's light page background showing through at the edges. -->
    <style name="Theme.Nimmesh.Scanner" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
