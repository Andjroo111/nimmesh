<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      A2 scope. The Bluetooth permissions and the connectedDevice foreground service that
      keep the mesh alive belong to A6 and are deliberately absent until the radio exists:
      an app that asks for Bluetooth and then does nothing with it is worse than one that
      does not ask yet.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The Send bar's scan button. Requested at the moment of use, never at launch. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- A phone without a camera can still do everything else, so this must not filter it out. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="NIMmesh"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nimmesh">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".QrScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Nimmesh.Scanner" />
    </application>
</manifest>
