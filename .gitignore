# Rust
/target/
**/target/
Cargo.lock.bak
*.rs.bk
*.pdb

# UniFFI / generated bindings build artifacts
/bindings/generated/
*.xcframework/
*.so
*.a
*.dylib

# Swift / Xcode
.build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
.swiftpm/
# Generated by cargo-swift (reproducible: cd crates/nimmesh-core && cargo swift package -n NimmeshCore -p ios -y)
crates/nimmesh-core/NimmeshCore/
# Generated by XcodeGen (reproducible from apple/project.yml: cd apple && xcodegen generate)
apple/*.xcodeproj
apple/build/
apple/NimmeshApp/Info.plist
# Generated by cargo-swift / uniffi-bindgen (reproducible)
crates/nimmesh-core/generated/

# Android / Gradle
.gradle/
/android/build/
/android/app/build/
/android/core/build/
/android/local.properties
*.apk
*.aab
*.keystore
*.jks
.cxx/
# Generated by android/scripts/build-core.sh (reproducible): the Rust core's Android
# libraries and the UniFFI Kotlin bindings generated FROM them. Committing either would
# let the checked-in bindings drift from the library they describe, which is the exact
# contract-version mismatch the pinned uniffi version exists to prevent.
/android/core/src/main/jniLibs/
/android/core/src/main/kotlin/
# Synced from webui/ at build time by the :app syncWebui task. The source of truth is
# webui/ at the repo root, shared with the iOS app.
/android/app/src/main/assets/webui/

# Foundry (contracts/)
contracts/out/
contracts/cache/

# Node (tooling only, if any)
node_modules/

# Secrets / local config — NEVER commit
*.env
.env*
secrets/
local.properties
google-services.json
GoogleService-Info.plist
*.mobileprovision
*.p8
*.p12

# OS / editor / agent tooling
.DS_Store
*.swp
.idea/
.vscode/
.claude/
build/
